# Servidor HTTP local (Express)
PORT=3001
HOST=127.0.0.1
LOCAL_STATE_DIR=.local

# Navegacion local Stagehand/Chromium
# CHROME_PATH=/usr/bin/google-chrome
HEADLESS=true
OPERATION_TIMEOUT_MS=240000

# Limites de procesamiento seguro
MAX_CSV_BYTES=10485760
MAX_CSV_ROWS=20000

# IA opcional (solo si se comprueba necesidad de Stagehand con IA)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Variables para pruebas explicitas de smoke (NO se cargan por defecto en la app)
# TRIBUTARIA_USER=
# TRIBUTARIA_PASS=
# CLAVE_UNICA_USER=
# CLAVE_UNICA_PASS=
# Compatibilidad con clave typo heredada en configuracion previa:
# TIBUTARIA_USER=
