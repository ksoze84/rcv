{
  "name": "rcv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -n \"server,web\" -c \"blue,green\" \"tsx watch server/src/index.ts\" \"vite --config web/vite.config.ts web\"",
    "build": "npm run build --workspace=@rcv/server && npm run build --workspace=@rcv/web",
    "start": "node server/dist/server/src/index.js",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "install:chromium": "npx playwright install --with-deps chromium"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "4.1.0",
    "@tanstack/react-virtual": "3.14.13",
    "csv-parse": "6.2.1",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "lucide-react": "1.16.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/express": "5.0.6",
    "@types/node": "24.11.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.55.0",
    "@typescript-eslint/parser": "8.55.0",
    "@vitejs/plugin-react": "5.1.4",
    "concurrently": "9.2.1",
    "eslint": "9.39.4",
    "jsdom": "28.1.0",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "4.1.2"
  }
}
